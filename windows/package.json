{
  "name": "perspective-usb-bridge-windows",
  "version": "0.7.0",
  "private": true,
  "description": "Perspective USB Bridge desktop client (Windows and macOS)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "pack": "electron-builder --win nsis",
    "pack:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "uk.co.perspectivestudio.usbbridge",
    "productName": "Perspective USB Bridge",
    "artifactName": "PerspectiveUSBBridge-Windows-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "PerspectiveCameraBridge-Mac-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Perspective connects to your Samsung tablet on the local network to receive its camera and microphone.",
        "LSMinimumSystemVersion": "12.0"
      }
    },
    "dmg": {
      "title": "Perspective Camera Bridge ${version}"
    }
  }
}
